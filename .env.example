# Development and single-service configuration. For a complete installation with Docker see
# selfhost/README.md (its own selfhost/.env is written by selfhost/init.mjs).

# AI keys (ADR-06: at most these three; any one is enough to start web, md-sync and the MCP
# server). Models are chosen per task in Settings → AI routing
# (kortex.user_settings.ai_routing_config), never hardcoded here. The embedding model is pinned
# per user on the first embedding (kortex.user_settings.embedding_lock); switching it needs
# `pnpm --filter @kortex/md-sync reembed`.
# Anthropic direct: primary for all intelligent text tasks (summaries, tagging, clustering,
# extraction, meeting coaching, digests, RAG copilot). CLAUDE_API_KEY is read as a legacy alias.
ANTHROPIC_API_KEY="<YOUR_ANTHROPIC_API_KEY>"
# Multi-model gateways: vision/OCR, embeddings, alternative LLMs (OpenRouter, data_collection=deny)
OPENROUTER_API_KEY="<YOUR_OPENROUTER_API_KEY>"
# Speech-to-text, document parsing, OCR (Eden AI routes to the underlying providers)
EDENAI_API_KEY="<YOUR_EDENAI_API_KEY>"

# Supabase (self-hosted on Coolify: Core Database, Auth, Storage & Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://supabase.example.com"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_KEY>"
# Optional, server only: where the web server itself reaches the Supabase API when the public
# address above does not lead there from inside its container (selfhost/ sets it).
# SUPABASE_INTERNAL_URL=
# Web app data source: "supabase" (live, needs the two NEXT_PUBLIC_ keys above) or "mock"
# (prototype data, no login). Default: supabase when the keys are set. See apps/web/README.md.
KORTEX_DATA_SOURCE="supabase"
# Time zone for "today", the daily note and item dates in the web app
KORTEX_TIMEZONE="Europe/Berlin"
# Role of the user for the live meeting coach prompt (optional, e.g. "CTO")
# KORTEX_COACH_ROLE=""
# Images per clip/PDF that vision describes (0 = off, max. 10, default 5)
# KORTEX_MAX_EMBEDDED_IMAGES=5
# Direct Postgres connection for migrations, via SSH tunnel (DB port is not public)
SUPABASE_DB_URL="postgresql://postgres:<PASSWORD>@127.0.0.1:54322/postgres?sslmode=disable"
# SSH access to the Coolify server (tunnel, type generation, verify); see packages/db/README.md
KORTEX_SSH_HOST="root@<COOLIFY_SERVER_IP>"
KORTEX_SSH_KEY="C:/Users/<you>/.ssh/<key>"

# Prod guard / ops scripts (scripts/ops/*.mjs, docs/orchestrator/prod-guard.md)
# Coolify REST fallback: Coolify → Keys & Tokens → API tokens (read + deploy is enough)
COOLIFY_URL="https://coolify.example.com"
COOLIFY_API_TOKEN="<YOUR_COOLIFY_API_TOKEN>"
# Addresses of your instance (a private kortex.instance.json in the repo root can supply them instead)
# KORTEX_WEB_URL="https://kortex.example.com"
# KORTEX_MCP_URL="https://mcp.kortex.example.com"
# KORTEX_COOLIFY_WEB_UUID="<COOLIFY_APP_UUID_WEB>"
# KORTEX_COOLIFY_MCP_UUID="<COOLIFY_APP_UUID_MCP>"
# USD → EUR for the AI budget (web app and scripts/ops/budget.mjs), default 1.08 USD per EUR
# KORTEX_USD_PER_EUR="1.08"

# Personal API token for the browser extension / mobile app (POST /api/ingest with Bearer)
KORTEX_API_TOKEN="<LONG_RANDOM_TOKEN>"
KORTEX_API_TOKEN_USER_ID="<YOUR_SUPABASE_USER_UUID>"

# Server cron (POST /api/cron/*, header X-Kortex-Cron-Secret; Coolify scheduled task, hourly).
# Random, at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KORTEX_CRON_SECRET="<LONG_RANDOM_SECRET>"
# Mail to Kortex (POST /api/ingest/mail, Resend inbound webhook; docs/mail-to-kortex.md).
# Without all three the endpoint answers 503 and the settings card says "not set up".
# RESEND_API_KEY: API key with full access (reads received emails and attachments).
# RESEND_WEBHOOK_SECRET: signing secret of the email.received webhook (whsec_...).
# KORTEX_INBOUND_MAIL_DOMAIN: receiving domain, addresses are <token>@<domain>.
# RESEND_API_KEY="<YOUR_RESEND_API_KEY>"
# RESEND_WEBHOOK_SECRET="<whsec_...>"
# KORTEX_INBOUND_MAIL_DOMAIN="in.kortex.example.com"
# Weekly digest: the hour (in KORTEX_TIMEZONE) from which a user's digest day counts (default 7)
KORTEX_DIGEST_HOUR="7"

# Local Markdown Vault & MCP Server (both act for exactly this user)
KORTEX_VAULT_PATH="C:/Users/<you>/KortexVault"
KORTEX_USER_ID="<YOUR_SUPABASE_USER_UUID>"
# md-sync AI enrichment: on by default with any AI key; folders to enrich (comma list)
# KORTEX_SYNC_INGEST="1"
# KORTEX_SYNC_INGEST_FOLDERS="40_AI_Memories"
MCP_HTTP_PORT="3333"
MCP_BEARER_TOKEN="<YOUR_LOCAL_MCP_TOKEN>"
# MCP server, preferred auth: mint user JWTs locally so RLS applies (Supabase JWT_SECRET from the
# Coolify service). Without it the MCP server uses SUPABASE_SERVICE_ROLE_KEY (also hybrid search).
# The web app needs the same secret for the desktop vault sync (POST /api/sync/session answers 503
# without it).
# SUPABASE_JWT_SECRET="<SUPABASE_JWT_SECRET>"
# Optional MCP switches: KORTEX_MCP_EMBEDDINGS="0" (full-text only), KORTEX_MCP_ORGANIZE="1"

# Optional Direct Overrides (ADR-06). Not needed: Eden AI / OpenRouter cover these capabilities.
# Set one only to call that provider directly instead of through the gateway.
# DEEPGRAM_API_KEY="<YOUR_DEEPGRAM_KEY>"      # live meeting / podcast STT instead of Eden AI
# DEEPGRAM_MODEL="<deepgram-model-id>"        # optional; Deepgram's default when unset
# GROQ_API_KEY="<YOUR_GROQ_KEY>"              # Whisper Large v3 Turbo instead of Eden AI
# JINA_API_KEY="<YOUR_JINA_KEY>"              # Jina Reader web extraction (keyless calls get 401)
# FIRECRAWL_API_KEY="<YOUR_FIRECRAWL_KEY>"    # Firecrawl web extraction fallback
# OMDB_API_KEY="<YOUR_OMDB_KEY>"              # OPTIONAL: film/series enrichment via OMDb (free key at omdbapi.com). Without it a routed LLM proposes metadata (marked metadata.enrichment.source = llm)

# Optional: cover search over Unsplash in the note editor (W4; server proxy GET /api/covers/unsplash).
# Access Key of an Unsplash app (unsplash.com/developers). Without it the cover dialog offers the upload only.
# UNSPLASH_ACCESS_KEY="<YOUR_UNSPLASH_ACCESS_KEY>"

# MCP server remote mode (claude.ai custom connector, OAuth 2.1; see packages/mcp-server/REMOTE.md).
# Set MCP_PUBLIC_URL only on the deployed server, not for local stdio/HTTP use.
# MCP_PUBLIC_URL="https://mcp.example.com"        # public origin, https, no path
# MCP_OAUTH_SECRET="<48+ random chars>"           # signs codes/tokens; rotating it revokes all grants
# MCP_OAUTH_ALLOWED_USER_IDS="<uuid>[,<uuid>]"    # defaults to KORTEX_USER_ID; the Supabase instance is shared
# MCP_TRUST_PROXY="true"                          # behind Traefik/Coolify (reads the client IP from X-Forwarded-For)
# MCP_ACCEPT_SUPABASE_TOKENS="1"                  # optional: also accept Supabase user JWTs as bearer tokens
# MCP_OAUTH_REDIRECT_URIS="https://app.example/cb" # optional extra redirect URIs (Claude and loopback are built in)
# MCP_CORS_ORIGINS="https://claude.ai,https://claude.com"  # optional, browser origins allowed on /mcp
# Remote mode needs SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_JWT_SECRET (per-user RLS; no service role).

# EAS Update code signing is OPTIONAL (needs the EAS Production plan or an own update server; apps/mobile/certs/README.md).
# Path to the PRIVATE key, always outside the repo. Default if unset: ~/.kortex/eas/private-key.pem. Never put a key or its content here.
# KORTEX_EAS_CODESIGN_KEY="C:/Users/<you>/.kortex/eas/private-key.pem"
