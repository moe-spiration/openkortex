# Kortex self-hosting: every variable of selfhost/docker-compose.yml.
# Do not copy this file by hand: `node selfhost/init.mjs --url … --email …` writes selfhost/.env
# with the same variables and freshly generated secrets. This file explains them.

# --- Address ------------------------------------------------------------------------------------
# Where browsers and apps reach Kortex. One address serves the web app, the Supabase API
# (/auth/v1, /rest/v1, /realtime/v1, /storage/v1) and the MCP server (/mcp).
# The address is built into the web app: after changing it run `docker compose up -d --build`.
KORTEX_URL=http://localhost:8000
# What the gateway listens on: ":<port>" for plain http, or a domain name (then Caddy serves
# https on 443 with a Let's Encrypt certificate and redirects port 80).
KORTEX_SITE_ADDRESS=:8000
# Published http port and the interface it binds to (127.0.0.1 when another proxy sits in front).
KORTEX_HTTP_PORT=8000
KORTEX_BIND=0.0.0.0
# Compose files and profiles. https on a domain adds docker-compose.https.yml (ports 443).
# The "mcp" profile starts the MCP server; it needs https (or http://localhost).
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=mcp
# IANA time zone for "today", the daily note and digests.
KORTEX_TIMEZONE=UTC

# --- Owner account ------------------------------------------------------------------------------
# Created on the first start, with the role "owner". The password is only read while the account
# does not exist yet; remove the line afterwards if you like.
KORTEX_OWNER_EMAIL=you@example.com
KORTEX_OWNER_PASSWORD=<at least 8 characters>
# The id the owner account gets (a random UUID). The MCP server lets only this user sign in.
KORTEX_USER_ID=<uuid>

# --- AI providers (see README) -------------------------------------------------------------------
# At most three keys, any one is enough to start. Models are chosen per task in
# Settings → AI routing, never here.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
EDENAI_API_KEY=

# --- Mail (optional) ----------------------------------------------------------------------------
# Without SMTP, new sign-ups are confirmed at once (ENABLE_EMAIL_AUTOCONFIRM=true). That is fine
# while you are the only user. Before inviting others on a public address, configure SMTP and set
# it to false, so an invitation can only be claimed by whoever receives mail at that address.
ENABLE_EMAIL_AUTOCONFIRM=true
# true: nobody can create an account any more (invited people cannot join either).
DISABLE_SIGNUP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Kortex

# --- Secrets (generated by init.mjs) -------------------------------------------------------------
# Changing one of these later breaks the existing database or signs everybody out.
POSTGRES_PASSWORD=<generated>
# Signs every login token. ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with it.
JWT_SECRET=<generated>
# Public key of the browser and the apps (role "anon"; row level security protects the data).
ANON_KEY=<generated>
# Full access, server side only. Never give it to a client.
SERVICE_ROLE_KEY=<generated>
SECRET_KEY_BASE=<generated>
REALTIME_DB_ENC_KEY=<generated>
# Header X-Kortex-Cron-Secret of the hourly jobs (service "cron").
KORTEX_CRON_SECRET=<generated>
# Signs the sign-in of the MCP server; rotating it revokes every connector.
MCP_OAUTH_SECRET=<generated>

# --- Optional -----------------------------------------------------------------------------------
# More variables for the web app only (direct provider overrides, inbound mail, Unsplash, …) go
# into selfhost/.env.web, one NAME=value per line. The names are listed in the root .env.example.
