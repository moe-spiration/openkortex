{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "Local React windows (bundled index.html): meeting HUD, quick capture, tray menu and the small native windows. Not `main`, which shows the remote web app and gets no capability (review N5 #8).",
  "windows": [
    "hud",
    "capture",
    "tray",
    "meetings",
    "audio",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "allow-get-meeting-state",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-upload-recording",
    "allow-discard-recording",
    "core:window:allow-set-size",
    "allow-account-status",
    "allow-connect-account",
    "allow-disconnect-account",
    "allow-set-hud-mode",
    "allow-set-stealth",
    "allow-list-audio-devices",
    "allow-select-audio-device",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-test-recording",
    "allow-quick-capture",
    "allow-start-voice-note",
    "allow-stop-voice-note",
    "allow-connect-token",
    "allow-meeting-clip",
    "allow-meeting-task",
    "allow-refresh-coaching",
    "allow-open-in-main",
    "allow-open-window",
    "allow-show-main",
    "allow-hide-to-tray",
    "allow-quit-app",
    "allow-launcher-search",
    "allow-launcher-ask",
    "allow-paste-text",
    "allow-grab-selection",
    "allow-close-launcher",
    "allow-pending-connect",
    "allow-confirm-connect",
    "allow-dismiss-connect",
    "allow-open-connect",
    "allow-get-reminders",
    "allow-set-reminders",
    "allow-set-server",
    "allow-get-locale",
    "allow-set-locale",
    "allow-vault-status",
    "allow-vault-pick-folder",
    "allow-vault-check-folder",
    "allow-vault-set-folder",
    "allow-vault-set-enabled",
    "allow-vault-skip-setup",
    "allow-vault-sync-now",
    "allow-vault-open",
    "allow-run-selftest",
    "allow-stop-web-recording",
    "allow-set-theme"
  ]
}
