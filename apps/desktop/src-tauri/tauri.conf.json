{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKortex",
  "version": "0.6.4",
  "identifier": "io.github.moe-spiration.openkortex",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3400",
    "beforeBuildCommand": "pnpm build && node scripts/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenKortex",
        "url": "index.html",
        "width": 1392,
        "height": 788,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "hud",
        "title": "OpenKortex Meeting HUD",
        "url": "index.html",
        "width": 400,
        "height": 684,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "capture",
        "title": "OpenKortex Quick Capture",
        "url": "index.html",
        "width": 680,
        "height": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "tray",
        "title": "OpenKortex Tray",
        "url": "index.html",
        "width": 320,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OpenKortex",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp"
      }
    },
    "resources": { "sidecar/": "sidecar/" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["kortex"] } }
  }
}
