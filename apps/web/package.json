{
  "name": "@kortex/web",
  "version": "0.6.4",
  "private": true,
  "scripts": {
    "sync:packs": "node ../../packages/theme-packs/scripts/sync-web.mjs",
    "dev": "node ../../packages/theme-packs/scripts/sync-web.mjs && next dev",
    "build": "node ../../packages/theme-packs/scripts/sync-web.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --project=prod",
    "audit:phase1": "node --env-file=.env.local scripts/phase1-audit.mjs",
    "e2e:live": "playwright test --project=live",
    "e2e:smoke": "playwright test -c playwright.smoke.config.ts --project=smoke-prod",
    "e2e:smoke:dev": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.152",
    "@base-ui/react": "1.9.0",
    "@kortex/ai-core": "workspace:*",
    "@kortex/db": "workspace:*",
    "@kortex/i18n": "workspace:*",
    "@kortex/mcp-server": "workspace:*",
    "@kortex/theme-packs": "workspace:*",
    "@kortex/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.148",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "d3-force-3d": "^3.0.6",
    "epubjs": "^0.3.93",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.61.0",
    "next": "~15.5.28",
    "pdfjs-dist": "^6.4.299",
    "react": "~19.1.10",
    "react-dom": "~19.1.10",
    "react-virtuoso": "4.18.21",
    "sonner": "2.0.8",
    "three": "^0.181.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "eslint-config-next": "~15.5.28",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  },
  "license": "AGPL-3.0-only"
}
