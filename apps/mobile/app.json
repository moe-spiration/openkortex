{
  "expo": {
    "name": "OpenKortex",
    "slug": "kortex",
    "scheme": "kortex",
    "version": "0.6.9",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "io.github.moe_spiration.openkortex",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "*/*"
          ],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F6",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#101014"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "OpenKortex records voice memos while you hold the orb."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/adaptive-monochrome.png",
          "color": "#6366F1",
          "defaultChannel": "reminders"
        }
      ],
      "expo-background-task",
      "./plugins/with-quick-capture",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "KortexCapture",
              "label": "OpenKortex Capture",
              "description": "Sprachnotiz, Notiz oder Foto festhalten; zweizeilig mit Frag-Kortex-Leiste",
              "minWidth": "180dp",
              "minHeight": "56dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 0
            },
            {
              "name": "KortexToday",
              "label": "OpenKortex Today",
              "description": "Fällige Erinnerungen und Tasks, scrollbar, Tasks direkt abhaken",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "KortexEntries",
              "label": "OpenKortex Einträge",
              "description": "Neueste Einträge, Favoriten oder Inbox als scrollbare Karten",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "KortexCheckin",
              "label": "OpenKortex Energie",
              "description": "Energie-Check-in mit einem Tipp, Serie und Woche",
              "minWidth": "250dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "io.github.moe_spiration.openkortex",
      "icon": "./assets/brand/icon.png",
      "supportsTablet": false
    }
  }
}
